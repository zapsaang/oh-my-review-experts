    "slicing": {
      "description": "File classification and grouping settings.",
      "default": {
        "enabled": true,
        "maxSlices": 4,
        "skipDocsOnly": true,
        "skipTestOnlyHeavyReview": true,
        "forceWholeTargetAboveSlices": 12
      },
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable the file slicing engine that groups changed files into coherent review slices.",
          "default": true,
          "type": "boolean"
        },
        "maxSlices": {
          "description": "Maximum number of slices to generate. Range: 1-32.",
          "default": 4,
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "skipDocsOnly": {
          "description": "Skip heavy review for docs-only slices.",
          "default": true,
          "type": "boolean"
        },
        "skipTestOnlyHeavyReview": {
          "description": "Skip heavy review for test-only slices.",
          "default": true,
          "type": "boolean"
        },
        "forceWholeTargetAboveSlices": {
          "description": "When the estimated number of slices exceeds this threshold, review the entire target as one unit instead of slicing. Range: 1-100.",
          "default": 12,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "partialRerun": {
      "description": "Partial rerun settings for failed reviewer tasks.",
      "default": {
        "enabled": true,
        "maxRetriesPerTask": 1
      },
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable partial rerun: when a reviewer fails, re-run only that task instead of the whole pipeline.",
          "default": true,
          "type": "boolean"
        },
        "maxRetriesPerTask": {
          "description": "Maximum retry attempts per failed task. Range: 0-1.",
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "costGuardrail": {
      "description": "Cost guardrail settings to prevent accidental high-cost reviews.",
      "default": {
        "enabled": true,
        "maxEstimatedTasks": 24,
        "compactModeThreshold": 20,
        "hardStopThreshold": 60
      },
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable cost estimation and guardrails before launching the review pipeline.",
          "default": true,
          "type": "boolean"
        },
        "maxEstimatedTasks": {
          "description": "Maximum estimated tasks before switching to compact mode. Range: 1-1000.",
          "default": 24,
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "compactModeThreshold": {
          "description": "Estimated task threshold for compact mode (reduced reviewer matrix). Range: 1-1000.",
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "hardStopThreshold": {
          "description": "Absolute maximum estimated tasks; pipeline halts if exceeded. Range: 1-1000.",
          "default": 60,
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "arbitration": {
      "description": "Arbitration strategy settings for merging reviewer findings.",
      "default": {
        "hierarchicalThreshold": 3
      },
      "type": "object",
      "properties": {
        "hierarchicalThreshold": {
          "description": "Number of slices above which hierarchical arbitration is used instead of flat merging. Range: 1-32.",
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "additionalProperties": false
    },
    "report": {
      "description": "Report output settings.",
      "default": {
        "enabled": true,
        "directory": ".omre/reports",
        "latestMarkdown": "latest.md",
        "latestJson": "latest.json",
        "timestamped": true
      },
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable report generation and persistence.",
          "default": true,
          "type": "boolean"
        },
        "directory": {
          "description": "Directory for report output. Must be a safe relative path (no .., no absolute paths).",
          "default": ".omre/reports",
          "type": "string",
          "pattern": "^(?!\\/)((?!\\.\\.)[a-zA-Z0-9_\\-\\.\\/])+$"
        },
        "latestMarkdown": {
          "description": "Filename for the latest markdown report.",
          "default": "latest.md",
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_\\-\\.]+$"
        },
        "latestJson": {
          "description": "Filename for the latest JSON report.",
          "default": "latest.json",
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_\\-\\.]+$"
        },
        "timestamped": {
          "description": "Generate timestamped history copies alongside latest.md/latest.json.",
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "handoff": {
      "description": "Handoff protocol settings for structured subagent output.",
      "default": {
        "enabled": true,
        "directory": ".omre/handoffs"
      },
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable the handoff protocol for structured subagent communication.",
          "default": true,
          "type": "boolean"
        },
        "directory": {
          "description": "Directory for handoff files. Must be a safe relative path (no .., no absolute paths).",
          "default": ".omre/handoffs",
          "type": "string",
          "pattern": "^(?!\\/)((?!\\.\\.)[a-zA-Z0-9_\\-\\.\\/])+$"
        }
      },
      "additionalProperties": false
    },
