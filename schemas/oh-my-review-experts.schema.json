{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zapsaang/oh-my-review-experts/main/schemas/oh-my-review-experts.schema.json",
  "title": "Oh My Review Experts Config",
  "description": "Configuration schema for the oh-my-review-experts OpenCode plugin.",
  "type": "object",
  "properties": {
    "enabled": {
      "description": "Globally enable or disable the review plugin.",
      "default": true,
      "type": "boolean"
    },
    "command": {
      "description": "Slash command registration settings.",
      "default": {
        "enabled": true,
        "name": "review-code",
        "aliases": [
          "rc"
        ],
        "injection": "both",
        "scopeResolution": "auto"
      },
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable the /review-code slash command.",
          "default": true,
          "type": "boolean"
        },
        "name": {
          "description": "Slash command name. Alphanumeric, underscore, or hyphen only. Forbidden names: __proto__, constructor, prototype.",
          "default": "review-code",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "aliases": {
          "description": "Alternative names for the slash command.",
          "default": [
            "rc"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          }
        },
        "injection": {
          "description": "How the command is wired: 'both' registers via config hook and intercepts execution; 'hook' same as both; 'disabled' mutes the plugin; 'tool' disables slash commands but keeps plugin tools available.",
          "default": "both",
          "type": "string",
          "enum": [
            "hook",
            "tool",
            "both",
            "disabled"
          ]
        },
        "scopeResolution": {
          "description": "How user-provided args drive review scope. 'auto' (default) parses commit/branch/path/staged forms deterministically. 'guidance-only' treats args as opaque guidance text and uses the default git diff HEAD scope (preserves pre-0.x behavior).",
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "guidance-only"
          ]
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "description": "Agent-specific model and inference settings.",
      "default": {},
      "type": "object",
      "properties": {
        "omre-reviewer-spec": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "variant": {
              "description": "Model variant. Passed through to the runtime.",
              "type": "string",
              "enum": [
                "max",
                "high",
                "medium",
                "low"
              ]
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "top_p": {
              "description": "Nucleus sampling cutoff. Passed through to the runtime.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
