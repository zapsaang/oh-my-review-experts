{
  "name": "oh-my-review-experts",
  "version": "0.1.2",
  "description": "Runtime-first OpenCode review-code plugin with built-in expert agents, slicing, partial rerun, and report export.",
  "type": "module",
  "license": "MIT",
  "author": "zapsaang",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zapsaang/oh-my-review-experts.git"
  },
  "keywords": [
    "opencode",
    "plugin",
    "code-review",
    "multi-agent",
    "review-code"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "omre": "dist/cli.js",
    "oh-my-review-experts": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --sourcemap --external @opencode-ai/plugin --external @opencode-ai/sdk",
    "generate-schema": "tsx scripts/generate-json-schema.ts",
    "prebuild": "npm run generate-schema",
    "postbuild": "node scripts/verify-packaging.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preversion": "npm run typecheck && npm run test",
    "postversion": "git push && git push --tags",
    "publish:dry-run": "node scripts/publish-dual.js --dry-run",
    "publish:both": "node scripts/publish-dual.js",
    "pack:local": "npm pack"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.14.46",
    "@types/node": "^22.13.5",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.1.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
