{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zapsaang/oh-my-review-experts/main/schemas/oh-my-review-experts.schema.json",
  "title": "Oh My Review Experts Config",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "reviewDimension": {
      "type": "string",
      "enum": ["spec", "quality", "security", "performance", "concurrency"]
    },
    "sliceType": {
      "type": "string",
      "enum": ["business-module", "migration", "api-contract", "dependency-change", "infra-change", "shared-library", "test-only", "docs-only"]
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    }
  },
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Master switch to enable or disable the plugin."
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "description": "Slash-command injection settings.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether to intercept /review-code commands."
        },
        "name": {
          "type": "string",
          "description": "Primary command name.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "aliases": {
          "type": "array",
          "description": "Alternative command names.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_-]+$"
          }
        },
        "injection": {
          "enum": ["hook", "tool", "both", "disabled"],
          "description": "How to inject the command into the runtime."
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "description": "Model identifiers for each workflow role.",
      "properties": {
        "orchestrator": { "type": "string", "description": "Model for workflow orchestration." },
        "spec": { "type": "string", "description": "Model for spec compliance reviewer." },
        "quality": { "type": "string", "description": "Model for code quality reviewer." },
        "security": { "type": "string", "description": "Model for security reviewer." },
        "performance": { "type": "string", "description": "Model for performance reviewer." },
        "concurrency": { "type": "string", "description": "Model for concurrency reviewer." },
        "slicePlanner": { "type": "string", "description": "Model for slice planner." },
        "validator": { "type": "string", "description": "Model for result validator." },
        "sliceArbiter": { "type": "string", "description": "Model for slice arbiter." },
        "globalArbiter": { "type": "string", "description": "Model for global arbiter." },
        "reportWriter": { "type": "string", "description": "Model for report writer." }
      }
    },
    "slicing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Heuristic diff-slicing settings.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable automatic slicing."
        },
        "maxSlices": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "Maximum number of slices to generate."
        },
        "skipDocsOnly": {
          "type": "boolean",
          "description": "Omit docs-only slices from review."
        },
        "skipTestOnlyHeavyReview": {
          "type": "boolean",
          "description": "Reduce reviewer set for test-only slices."
        },
        "forceWholeTargetAboveSlices": {
          "type": "integer",
          "minimum": 1,
          "description": "Force whole-target mode when estimated slices exceed this threshold."
        }
      }
    },
    "partialRerun": {
      "type": "object",
      "additionalProperties": false,
      "description": "Partial rerun policy for malformed reviewer outputs.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable partial rerun."
        },
        "maxRetriesPerTask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "Maximum retry attempts per reviewer task. Must not exceed 1 per review run contract."
        }
      }
    },
    "costGuardrail": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cost control thresholds.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable cost guardrails."
        },
        "maxEstimatedTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Soft maximum for estimated reviewer tasks."
        },
        "compactModeThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Threshold to enable compact review mode."
        },
        "hardStopThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Hard stop threshold for estimated tasks."
        }
      }
    },
    "arbitration": {
      "type": "object",
      "additionalProperties": false,
      "description": "Arbitration behavior settings.",
      "required": ["hierarchicalThreshold"],
      "properties": {
        "hierarchicalThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "Enable hierarchical arbitration when slice count reaches or exceeds this threshold."
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "description": "Report output settings.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable report generation."
        },
        "directory": {
          "type": "string",
          "description": "SECURITY: Must be a safe relative path. No absolute paths, no .. segments.",
          "pattern": "^(?!\\/)((?!\\.\\.)[a-zA-Z0-9_\\-\\.\\/])+$"
        },
        "latestMarkdown": {
          "type": "string",
          "description": "SECURITY: Must be a safe filename. No path separators, no .. segments.",
          "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_\\-\\.]+$"
        },
        "latestJson": {
          "type": "string",
          "description": "SECURITY: Must be a safe filename. No path separators, no .. segments.",
          "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_\\-\\.]+$"
        },
        "timestamped": {
          "type": "boolean",
          "description": "Also write timestamped history files."
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "description": "Subagent handoff file settings.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable handoff file persistence for subagent results."
        },
        "directory": {
          "type": "string",
          "description": "SECURITY: Must be a safe relative path. No absolute paths, no .. segments.",
          "pattern": "^(?!\\/)((?!\\.\\.)[a-zA-Z0-9_\\-\\.\\/])+$"
        }
      }
    },
    "reviewers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reviewer dimension assignment.",
      "properties": {
        "default": {
          "type": "array",
          "description": "Default reviewers for slices without a specific mapping.",
          "items": { "$ref": "#/$defs/reviewDimension" }
        },
        "bySliceType": {
          "type": "object",
          "description": "Per-slice-type reviewer overrides.",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/reviewDimension" }
          },
          "properties": {
            "business-module": { "type": "array", "items": { "$ref": "#/$defs/reviewDimension" } },
            "migration": { "type": "array", "items": { "$ref": "#/$defs/reviewDimension" } },
            "api-contract": { "type": "array", "items": { "$ref": "#/$defs/reviewDimension" } },
            "dependency-change": { "type": "array", "items": { "$ref": "#/$defs/reviewDimension" } },
            "infra-change": { "type": "array", "items": { "$ref": "#/$defs/reviewDimension" } },
            "shared-library": { "type": "array", "items": { "$ref": "#/$defs/reviewDimension" } },
            "test-only": { "type": "array", "items": { "$ref": "#/$defs/reviewDimension" } },
            "docs-only": { "type": "array", "items": { "$ref": "#/$defs/reviewDimension" } }
          }
        }
      }
    }
  }
}
