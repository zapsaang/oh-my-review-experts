    "command": {
      "additionalProperties": false,
      "default": {
        "aliases": [
          "rc"
        ],
        "enabled": true,
        "injection": "both",
        "name": "review-code",
        "scopeResolution": "auto"
      },
      "description": "Slash command registration settings.",
      "properties": {
        "aliases": {
          "default": [
            "rc"
          ],
          "description": "Alternative names for the slash command.",
          "items": {
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            },
            "pattern": "^[a-zA-Z0-9_-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": true,
          "description": "Enable the /review-code slash command.",
          "type": "boolean"
        },
        "injection": {
          "default": "both",
          "description": "How the command is wired: 'both' registers via config hook and intercepts execution; 'hook' same as both; 'disabled' mutes the plugin; 'tool' disables slash commands but keeps plugin tools available.",
          "enum": [
            "hook",
            "tool",
            "both",
            "disabled"
          ],
          "type": "string"
        },
        "name": {
          "default": "review-code",
          "description": "Slash command name. Alphanumeric, underscore, or hyphen only. Forbidden names: __proto__, constructor, prototype.",
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          },
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "scopeResolution": {
          "default": "auto",
          "description": "How user-provided args drive review scope. 'auto' (default) parses commit/branch/path/staged forms deterministically. 'guidance-only' treats args as opaque guidance text and uses the default git diff HEAD scope (preserves pre-0.x behavior).",
          "enum": [
            "auto",
            "guidance-only"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
